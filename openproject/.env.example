# .env.example — openproject_despacho: plantilla del .env de operaciones (copiar a <despacho>/operaciones/openproject/.env y completar).
# NO va a git: contiene el secreto de sesión y el token de API. config.sh lo carga para todos los scripts.

# --- docker compose ---
# Dirección por la que se accede a OpenProject en la LAN: IP del equipo + puerto (si la IP cambia, edite y ./iniciar.sh)
OPENPROJECT_HOST_NAME=192.168.1.100:8080
# Hosts adicionales permitidos (JSON): localhost, la IP y el nombre mDNS estable del equipo (`hostname`.local)
OPENPROJECT_HOSTS_ADICIONALES='["192.168.1.100","192.168.1.100:8080","localhost","localhost:8080","127.0.0.1","127.0.0.1:8080","mi-equipo.local","mi-equipo.local:8080"]'
# Clave secreta de sesión. Genere una con:  openssl rand -hex 64
OPENPROJECT_SECRET_KEY_BASE=pega_aqui_una_clave_larga_generada_con_openssl

# --- despliegue ---
# Perfil del despacho (proyectos, opciones de campos, roster): lo leen los seeds (sembrar.sh)
OPENPROJECT_PERFIL="/ruta/al/despacho/perfil/openproject.yml"
# URL con la que los puentes (bridges/) hablan con la API; token de API (Mi cuenta → Tokens de acceso)
OPENPROJECT_URL=http://localhost:8080
OPENPROJECT_TOKEN=
# Cuántos respaldos conserva respaldar.sh (los más recientes)
OPENPROJECT_RESPALDOS_CONSERVAR=14
# Contraseña temporal de los usuarios que siembra 70_usuarios.rb (se cambia en el primer ingreso)
OP_TEMP_PASSWORD=
