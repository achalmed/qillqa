# Qillqa — variables de entorno. Copiar a .env y cambiar TODAS las claves antes de usarlo con datos reales.
#   cp .env.example .env
# Los valores con espacios van entre comillas simples.

# --- Base de datos (PostgreSQL) ---
POSTGRES_DB=qillqa
POSTGRES_USER=qillqa
POSTGRES_PASSWORD=cambie-esta-clave

# --- Seguridad ---
JWT_SECRET=cambie-esto                         # openssl rand -hex 32
# Clave Fernet de la bóveda de accesos a mesas de partes externas. Vacía: se deriva de JWT_SECRET (si cambia
# JWT_SECRET, las claves guardadas quedan ilegibles). Generarla:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QILLQA_BOVEDA_CLAVE=
HORAS_SESION=12

# --- Cuenta administradora inicial ---
# No use «admin»: ese nombre está reservado y la cuenta se desactiva al arrancar.
ADMIN_USUARIO=administrador
ADMIN_CLAVE=qillqa-demo                         # vacía: la clave inicial es el usuario y se cambia al primer ingreso
DEMO_CLAVE=qillqa-demo                          # clave de las cuentas ficticias que crea `docker compose run --rm siembra`

# --- Identidad de la entidad ---
VITE_NOMBRE_DESPACHO='Entidad de demostración'  # nombre que muestra la web (inicio de sesión y menú)
SIGLAS=ABC-ENT                                  # siglas que cierran el número oficial: OFICIO N.° 0001-2026-ABC-ENT
PERIODO=2026                                    # período de la numeración (un año o un período anual: 2026-2027)
LUGAR=Lima                                      # lugar de la fecha de los documentos
# MDD_PERFIL_CONTENEDOR=/app/perfil              # perfil LaTeX de la entidad (membrete, firma, sello) dentro del contenedor;
#                                                # monte su carpeta en docker-compose.yml (modelo en perfil.ejemplo/)

# --- Puertos publicados (docker compose) ---
# QILLQA_PUERTO_WEB=5173
# QILLQA_PUERTO_API=8000                         # solo en 127.0.0.1

# --- Integraciones opcionales (vacías = apagadas) ---
# OPENPROJECT_URL=http://localhost:8080          # planificación de proyectos en OpenProject
# OPENPROJECT_TOKEN=                             # token de API de una cuenta administradora de OpenProject
# TELEGRAM_TOKEN=                                # puente con un grupo de Telegram
# TELEGRAM_CHAT=
# CALIBRE_DB=/ruta/a/metadata.db                 # biblioteca Calibre (solo lectura) para citar fuentes
# ZOTERO_URL=http://127.0.0.1:23119              # Zotero local (citas y referencias)
# IDENTIDAD_PERFIL=/ruta/a/perfil.json           # estudio de piezas gráficas del módulo Prensa
