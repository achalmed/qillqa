# sistema/sgdp.service.ejemplo — unidad systemd de usuario del SGDP; copiar a ~/.config/systemd/user/sgdp.service
# instalar_enlace_fijo.sh escribe la real con la ruta del repo; %h = home del usuario (lo expande systemd).
[Unit]
Description=SGDP — sistema de gestión documental del despacho (arranque y publicación)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/Documents/sgdp
ExecStart="%h/Documents/sgdp/arranque_automatico.sh"
ExecStop="%h/Documents/sgdp/detener.sh"
# arranque_automatico.sh espera hasta 20 min a cada cosa y reintenta.
TimeoutStartSec=3600

[Install]
WantedBy=default.target
