# .gitattributes — sgdp: normalización de texto, binarios, diffs por lenguaje y lo generado.

# ===== Normalización de fin de línea =====
# Todo lo que git detecte como texto se guarda con LF; en Linux se trabaja con LF y así no entran CRLF
# desde un Word o un editor de Windows. Lo binario de abajo queda excluido de esta regla.
* text=auto eol=lf

# Scripts de operación y plantillas de shell: LF obligatorio (un CRLF rompe el shebang).
*.sh text eol=lf
iniciar.sh text eol=lf

# ===== Binarios (nunca se normalizan ni se muestran como diff) =====
# Fuentes del marco documental, PDF de plantillas y ejemplos, imágenes de membretes.
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary

# SVG es texto (XML): se normaliza y se puede ver el diff.
*.svg text

# ===== Diffs por lenguaje (cabeceras de función en los hunks) =====
*.py diff=python
*.tex diff=tex
*.cls diff=tex
*.sty diff=tex
*.md diff=markdown

# ===== Lo generado, marcado para la plataforma =====
# linguist-generated pliega estos archivos en la revisión y los excluye de las estadísticas de lenguaje;
# -diff evita que un cambio regenerado llene el diff. Nunca se editan a mano: se regeneran con su herramienta.
docs/historial/exposicion-2026-09-04/guion_orador.md linguist-generated=true -diff
docs/historial/exposicion-2026-09-04/presentacion-sgdp.html linguist-generated=true -diff

# ===== Clasificación de lenguajes (GitHub Linguist) =====
# Plantillas Jinja (.j2) del generador del informe-sr: son plantillas, no código del proyecto.
*.j2 linguist-language=Jinja
# Las clases y plantillas LaTeX del marco cuentan como TeX, no como documentación.
marco_documental/templates/** linguist-documentation=false

# ===== Exportación (git archive) =====
# Lo que no viaja en un paquete de distribución del código.
.gitattributes export-ignore
.dockerignore export-ignore
perfil.ejemplo/ export-ignore
