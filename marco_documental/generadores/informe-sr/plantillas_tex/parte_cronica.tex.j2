%% parte_06_cronica.tex -- GENERADO (cronica de cada dia: foto de apertura, prosa a dos columnas con foto de columna opcional, y galeria del dia)
\clearpage
\BLOCK{ for d in dias }
\BLOCK{ set c = d.cronica }
\BLOCK{ if c.foto_archivo }
\isrfotoapertura{\VAR{c.foto_archivo}}{\VAR{c.foto_pie|tex}}
\BLOCK{ endif }
\articulo{\VAR{c.kicker|default(d.titulo, true)|tex}}{\VAR{c.titular|tex}}{\VAR{c.entrada|tex}}
\begin{columnas}
\BLOCK{ if c.foto_columna_archivo }
\VAR{c.relato_antes|md}
\isrfotocolumna{\VAR{c.foto_columna_archivo}}{\VAR{c.foto_columna_pie|tex}}
\VAR{c.relato_despues|md}
\BLOCK{ else }
\VAR{c.relato|md}
\BLOCK{ endif }
\end{columnas}
\BLOCK{ if c.galeria }
\isrgaleriatitulo{En imágenes}
\BLOCK{ for fila in c.galeria|batch(2) }
\isrgaleriafila{\VAR{fila[0].archivo_galeria}}{\VAR{fila[0].pie|tex}}{\VAR{fila[1].archivo_galeria if fila|length > 1 else ''}}{\VAR{fila[1].pie|tex if fila|length > 1 else ''}}
\BLOCK{ endfor }
\BLOCK{ endif }
\BLOCK{ endfor }
