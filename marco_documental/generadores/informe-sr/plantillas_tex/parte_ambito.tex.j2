%% parte_05_ambito.tex -- GENERADO (ambito territorial y cronograma de la semana)
\seccion{Ámbito territorial y cronograma}
\BLOCK{ if inf.get('ambito_descripcion') }\VAR{inf.ambito_descripcion|md}\BLOCK{ endif }

\isrfotoslot[\linewidth]{6.6cm}{MAPA DE LA RUTA · \VAR{inf.ambito_texto|tex}}
\isrfuente{Espacio preparado para el mapa de la ruta (provincias, distritos y centros poblados visitados). Se incorpora cuando el Centro de Inteligencia Legislativa entregue la cartografía.}

\isrkicker{Cronograma de la Semana}
\begin{isrcronograma}
\BLOCK{ for d in dias }
  \VAR{d.fecha_obj.day} de \VAR{mes_nombre|lower} & \isrpunto & \isrhitotexto{\VAR{d.titulo|tex}}{\VAR{d.ambito|tex} · \VAR{d.n_actividades} actividades\BLOCK{ if d.primera_hora and d.ultima_hora } · \VAR{d.primera_hora}–\VAR{d.ultima_hora}\BLOCK{ endif }} \\
\BLOCK{ endfor }
\end{isrcronograma}

\isrgrafico{\VAR{graficos.por_dia}}{Actividades por día}{Relato cronológico de la Semana de Representación (despacho).}

\isrkicker{Distritos y localidades visitados}
\begin{isrtabla}{X[1.3,l] X[1.1,l] X[2.6,l] Q[r,wd=2.0cm]}
  Provincia & Distrito & Localidades visitadas & Actividades \\
\BLOCK{ for d in datos.distritos_tabla }
  \VAR{d.provincia|tex} & \VAR{d.distrito|tex} & \VAR{d.localidades|tex} & \VAR{d.n} \\
\BLOCK{ endfor }
\end{isrtabla}
\isrfuente{Relato cronológico de la Semana. Las actividades sin distrito consignado en la fuente se agrupan como «por precisar».}
