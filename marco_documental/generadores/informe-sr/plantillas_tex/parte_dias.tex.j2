%% parte_06_dias.tex -- GENERADO (un capitulo por dia: separador, resumen, cronograma, fichas, galeria)
\BLOCK{ for d in dias }
\BLOCK{ set foto_cap = (d.fotos_galeria|selectattr('orientacion', 'equalto', 'horizontal')|list) }
\capitulo\BLOCK{ if foto_cap }[\VAR{foto_cap[0].archivo}]\BLOCK{ endif }{\VAR{d.titulo|tex}}{\VAR{d.ambito|tex}. \VAR{d.n_actividades} actividad\VAR{'es' if d.n_actividades != 1 else ''}\BLOCK{ if d.primera_hora and d.ultima_hora } registrada\VAR{'s' if d.n_actividades != 1 else ''} entre las \VAR{d.primera_hora} y las \VAR{d.ultima_hora} horas\BLOCK{ endif }; \VAR{d.n_pedidos} pedido\VAR{'s' if d.n_pedidos != 1 else ''} sistematizado\VAR{'s' if d.n_pedidos != 1 else ''}.}

\isrkicker{Resumen del día}
\noindent
\isrcifra{\VAR{d.n_actividades}}{actividades}{}\hfill
\isrcifra{\VAR{d.n_pedidos}}{pedidos sistematizados}{}\hfill
\isrcifra{\VAR{d.horas_decimal}}{de actividad con horario registrado\BLOCK{ if d.horas_texto } (\VAR{d.horas_texto})\BLOCK{ endif }}{}\hfill
\isrcifra{\VAR{d.n_ie}}{instituciones educativas visitadas}{}\par
\vspace{10pt}

\isrkicker{Cronograma}
\begin{isrcronograma}
\BLOCK{ for a in d.actividades }
  \VAR{a.hora_rango or 'sin hora'} & \BLOCK{ if a.hora_inicio }\isrpunto\BLOCK{ else }\isrpuntoclaro\BLOCK{ endif } & \isrhitotexto{\VAR{a.id} · \VAR{a.titulo|tex}}{\VAR{a.lugar|tex}\BLOCK{ if a.ubicacion } · \VAR{a.ubicacion|tex}\BLOCK{ endif } · \VAR{a.pedidos|length} pedido\VAR{'' if a.pedidos|length == 1 else 's'}} \\
\BLOCK{ endfor }
\end{isrcronograma}

\BLOCK{ for a in d.actividades }
\BLOCK{ set fl = (a.fotos_lista|selectattr('orientacion', 'equalto', 'horizontal')|list) + (a.fotos_lista|rejectattr('orientacion', 'equalto', 'horizontal')|list) }
\begin{fichaactividad}{id={\VAR{a.id}},titulo={\VAR{a.titulo|tex}},tipo={\VAR{a.tipo_nombre}},sector={\VAR{a.sector}},hora={\VAR{a.hora_rango}},duracion={\VAR{a.duracion_texto}},lugar={\VAR{a.lugar|tex}},ubicacion={\VAR{a.ubicacion|tex}},participantes={\VAR{a.participantes|lista|tex}},resumenpedidos={\VAR{a.resumen_pedidos|tex}},documentos={\VAR{a.documentos_lista|join(', ')|tex}},%
\BLOCK{ if fl }foto={\VAR{fl[0].archivo}},fotopie={\VAR{fl[0].pie|tex}},fotoancho={\VAR{'0.34' if fl[0].orientacion == 'horizontal' else '0.24'}}\BLOCK{ else }foto={slot}\BLOCK{ endif }%
\BLOCK{ if a.observaciones },observacion={\VAR{a.observaciones|tex}}\BLOCK{ endif }}
\BLOCK{ if a.contexto }
  \isrcontexto{\VAR{a.contexto|tex}}
\BLOCK{ endif }
\BLOCK{ if a.hallazgos }
  \isrsubtitulo{Hallazgos y pedidos recogidos}
  \begin{isrhallazgos}
\BLOCK{ for h in a.hallazgos }
    \item \VAR{h|tex}
\BLOCK{ endfor }
  \end{isrhallazgos}
\BLOCK{ elif not a.contexto }
  \isrcontexto{La fuente no consigna hallazgos ni pedidos individualizados para esta actividad.}
\BLOCK{ endif }
\end{fichaactividad}
\BLOCK{ endfor }
\BLOCK{ set extra = [] }
\BLOCK{ for a in d.actividades }
\BLOCK{ for f in a.fotos_lista[1:] }
\BLOCK{ if f.orientacion == 'horizontal' and extra|length < 4 }
\BLOCK{ set _ = extra.append(f) }
\BLOCK{ endif }
\BLOCK{ endfor }
\BLOCK{ endfor }
\BLOCK{ if extra }

\isrkicker{Registro fotográfico del día}
\BLOCK{ for f in extra }
\BLOCK{ if loop.index0 % 2 == 0 }\noindent\BLOCK{ endif }\isrfoto[0.485\linewidth]{\VAR{f.archivo}}{\VAR{f.pie|tex}}{\VAR{f.actividad} · \VAR{d.fecha_larga|capitalize}}\BLOCK{ if loop.index0 % 2 == 0 and not loop.last }\hfill\BLOCK{ else }\par\vspace{8pt}\BLOCK{ endif }

\BLOCK{ endfor }
\BLOCK{ endif }
\BLOCK{ endfor }
