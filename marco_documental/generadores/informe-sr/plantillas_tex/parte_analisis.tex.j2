\capitulo{Análisis: sectores, entidades y prioridades}{Lo que la Semana dice en conjunto: dónde se concentran los pedidos, qué entidades deben responder y qué es urgente.}

\VAR{inf.analisis_intro|md}

\begin{isrcaja}[oscura]{Lo que dice el dato}
De los \VAR{stats.n_pedidos} pedidos sistematizados, \VAR{sector_top[1]} (\VAR{(100 * sector_top[1] / stats.n_pedidos)|round|int}\,\%) corresponden al sector \VAR{sector_top[0]|lower|tex}; de las \VAR{stats.n_actividades} actividades registradas, \VAR{stats.n_ie} fueron visitas de trabajo a instituciones educativas. La entidad más requerida es \VAR{ent_top[0]|tex}, que figura como entidad requerida en \VAR{ent_top[1]} de los \VAR{stats.n_pedidos} pedidos registrados. \VAR{stats.por_prioridad.get('urgente', 0)} pedidos se proponen como urgentes por riesgo para la vida, la salud o la continuidad del servicio.
\end{isrcaja}

