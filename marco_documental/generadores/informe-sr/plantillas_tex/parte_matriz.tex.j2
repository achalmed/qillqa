%% parte_07_matriz.tex -- GENERADO (matriz de sistematizacion de pedidos, por dia)
\capitulo{Matriz de sistematización de pedidos}{\VAR{stats.n_pedidos} pedidos y hallazgos con entidad competente, actuación parlamentaria sugerida y prioridad propuesta según la pauta de seguimiento del despacho.}

\BLOCK{ if inf.get('matriz_intro') }\VAR{inf.matriz_intro|md}\BLOCK{ endif }

\BLOCK{ for d in dias }
\BLOCK{ set peds = [] }
\BLOCK{ for a in d.actividades }\BLOCK{ for p in a.pedidos_obj }\BLOCK{ set _ = peds.append(p) }\BLOCK{ endfor }\BLOCK{ endfor }
\BLOCK{ if peds }
\isrkicker{\VAR{d.titulo|tex} · \VAR{peds|length} pedidos}
\begin{isrmatriz}
\BLOCK{ for p in peds }
  \VAR{p.id}\newline{\isrtxpie \VAR{p.actividad}} & \VAR{p.pedido|tex} & \VAR{p.entidades|join('; ')|tex} & \VAR{p.actuacion|tex} & \isrprioridad{\VAR{p.prioridad_propuesta}} & \isrestado{\VAR{p.estado}} \\
\BLOCK{ endfor }
\end{isrmatriz}
\BLOCK{ endif }
\BLOCK{ endfor }
\isrfuente{Matriz de sistematización de la Semana de Representación (despacho, \VAR{mes_nombre|lower} de \VAR{inf.anio}). La prioridad es una propuesta del equipo de sistematización, pendiente de validación del despacho.}
