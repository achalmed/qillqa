{
  "manifest_version": 3,
  "name": "Qillqa · Mesa de partes",
  "version": "1.0.0",
  "description": "Muestra los datos del documento de Qillqa dentro de la página de la mesa de partes, para copiarlos o autocompletar el formulario.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "fondo.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["contenido.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "icons": { "16": "iconos/16.png", "48": "iconos/48.png", "128": "iconos/128.png" },
  "action": { "default_title": "Qillqa · Mesa de partes", "default_icon": { "16": "iconos/16.png", "48": "iconos/48.png" } }
}
